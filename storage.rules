rules_version = '2';

// =====================================================================
// TaskVault — Cloud Storage Security Rules
//
// The only thing stored is deposit-proof screenshots:
//   proofs/{userId}/{depositId}
//
//   * A user may upload / read / delete only proofs under their own
//     UID.
//   * The two admin emails may read everything (the admin-deposits
//     page shows the receipt inline for human review).
//   * Nothing else in the bucket is accessible.
// =====================================================================

service firebase.storage {

  // ---------- helpers ----------

  // A real (non-anonymous) signed-in user.
  function isUser() {
    return request.auth != null && request.auth.token.firebase != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
  }

  // The two official admin accounts (email/password accounts carry an
  // automatic `email` claim).
  function isAdmin() {
    return request.auth.token.email == 'beniwealth70@gmail.com' || request.auth.token.email == 'baasituoppor01@gmail.com';
  }

  match /b/{bucket}/o {

    // ---------- deposit proof screenshots ----------
    match /proofs/{userId}/{fileName=**} {
      allow read: if isUser() && request.auth.uid == userId || isAdmin();
      allow write: if isUser() && request.auth.uid == userId;
      allow delete: if isUser() && request.auth.uid == userId || isAdmin();
    }

    // ---------- everything else: admins only ----------
    // (write covers create, update and delete)
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

  }
}
